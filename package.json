{
  "name": "worshipflow",
  "version": "0.1.0",
  "private": true,
  "description": "WorshipFlow — the modern operating system for church worship teams.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "node prisma/reset.mjs",
    "db:push:local": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:generate:local": "prisma generate --schema prisma/schema.sqlite.prisma",
    "preview:worker": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types",
    "cf:build": "prisma generate --schema prisma/schema.prisma && opennextjs-cloudflare build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^0.427.0",
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "wrangler": "^4.86.0"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
