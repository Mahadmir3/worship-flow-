# ── WorshipFlow environment ──────────────────────────────────────────────
# Copy to .env (local) or set as Cloudflare secrets (production).

# Database — Supabase PostgreSQL.
# Supabase → Project Settings → Database → Connection string → "Connection pooling"
# Use the TRANSACTION MODE URI (port 6543) and append ?pgbouncer=true&connection_limit=1
# Example:
# DATABASE_URL=postgresql://postgres.abcdefghij:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Local demo only (SQLite): the preview in this workspace uses
#   DATABASE_URL="file:./dev.db"
# and `npm run db:push:local` to sync the schema.
